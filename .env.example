# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，绝不提交。
# 值来自 Azure Portal → 你的 Azure OpenAI 资源。

# 「密钥和终结点」页的 Endpoint，形如 https://xxx.openai.azure.com（结尾不要带斜杠也行）
AZURE_OPENAI_ENDPOINT=https://你的资源名.openai.azure.com

# 「密钥和终结点」页的 KEY 1 或 KEY 2
AZURE_OPENAI_API_KEY=在这里填你的key

# 「模型部署 / Deployments」里你给 gpt-image-1 起的【部署名】（不是模型 id "gpt-image-1"）
AZURE_OPENAI_IMAGE_DEPLOYMENT=你的部署名

# 可选，默认 preview
AZURE_OPENAI_API_VERSION=2025-04-01-preview
